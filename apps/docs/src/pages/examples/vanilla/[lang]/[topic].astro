---
import DemoLayout from '../../../../layouts/DemoLayout.astro';
import { chapters, type Language } from '../../../../lib/chapters';
export function getStaticPaths() {
  return (['en', 'zh-cn'] as const).flatMap(lang => chapters.map(c => ({ params: { lang, topic: c.topic }, props: { title: lang === 'en' ? c.title : c.zh } })));
}
const { lang, topic } = Astro.params;
---
<DemoLayout topic={topic!} lang={lang as Language} mode="vanilla">
  <iframe class="demo-frame" src={`/demos/vanilla/${lang}/${topic}.html`} title={Astro.props.title} id="vanilla-demo"></iframe>
</DemoLayout>
<script>
  const frame = document.querySelector<HTMLIFrameElement>('#vanilla-demo');
  if (frame) {
    const theme = () => { const root = frame.contentDocument?.documentElement; if (root) root.dataset.theme = document.documentElement.dataset.theme; };
    frame.addEventListener('load', theme);
    new MutationObserver(theme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    window.addEventListener('message', event => {
      if (event.origin !== location.origin || event.source !== frame.contentWindow || event.data?.type !== 'demo:resize') return;
      const height = Number(event.data.height);
      if (Number.isFinite(height) && height > 0) frame.style.height = `${Math.min(15000, Math.ceil(height) + 8)}px`;
    });
  }
</script>
