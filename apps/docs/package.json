{
  "name": "@cytocausal/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "postbuild": "pagefind --site out --output-path out/_pagefind",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "test:e2e": "playwright test",
    "check:examples": "node scripts/sync-examples.mjs",
    "test:examples": "node --test test/examples.test.ts"
  },
  "dependencies": {
    "@cytocausal/core": "*",
    "@cytocausal/cytoscape": "*",
    "@cytocausal/react": "*",
    "cytoscape": "3.31.0",
    "next": "^16.4.5",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/cytoscape": "^3.21.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "pagefind": "^1.6.0",
    "typescript": "^5"
  }
}
